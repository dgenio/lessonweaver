{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgenio/lessonweaver/main/schemas/trace.schema.json",
  "title": "LessonWeaver Trace Bundle",
  "description": "A deterministic LessonWeaver trace for one agent run.",
  "type": "object",
  "required": ["trace_id", "source", "task", "events", "outcome"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Optional trace schema version used by producers that pin a contract version.",
      "default": "1.0.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/traceEvent"
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "traceEvent": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "user_message",
            "assistant_message",
            "model_call",
            "tool_call",
            "tool_result",
            "error",
            "retry",
            "human_correction",
            "evaluation_result",
            "final_answer",
            "workflow_step"
          ]
        },
        "content": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "success": {
          "type": ["boolean", "null"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
